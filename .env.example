# =============================================================================
# mas_taxonomy — environment variables template
# Copy this file to ".env" (same directory) and fill in the values you need.
#   PowerShell:   Copy-Item .env.example .env
#   bash / zsh:   cp .env.example .env
#
# You only need ONE provider configured. The first provider in
# LLM_PROVIDER_PRIORITY whose key is set will be used.
# =============================================================================

# --- LLM API keys (set at least one) ----------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Google Vertex AI (optional, alternative to GEMINI_API_KEY) -------------
# Vertex AI uses a service-account JSON key file instead of an API key.
# 1) Create a service account in Google Cloud and download its JSON key.
# 2) Place the file in the project root (e.g. "vertex-credentials.json").
# 3) Set the variables below. The file itself is git-ignored (gen-lang-*).
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_CREDENTIALS_FILE=

# --- Provider priority -------------------------------------------------------
# Comma-separated list. The first provider with a configured key is selected.
# Valid values: openai, anthropic, gemini, vertexai
LLM_PROVIDER_PRIORITY=openai,anthropic,gemini,vertexai

# --- Optional: enable verbose debug dumps per LLM call ----------------------
# DEBUG_MODE=false
